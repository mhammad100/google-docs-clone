{
  "name": "docs-backend",
  "version": "1.0.0",
  "description": "Docs app API (Express + Knex + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "seed": "knex seed:run --knexfile knexfile.js",
    "db:setup": "npm run migrate && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "SKIP_DB_SETUP=1 vitest run tests/import.test.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "marked": "^15.0.12",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
