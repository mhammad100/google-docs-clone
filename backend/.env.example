# Local Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docs_dev
# Set to true for hosted Postgres (Neon, Supabase, Vercel Postgres)
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
